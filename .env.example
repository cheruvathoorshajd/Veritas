# AI / LLM — Gemini is the primary; Groq is the automatic fallback on quota errors
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Search / Retrieval (required for the verification loop)
TAVILY_API_KEY=your_tavily_api_key_here

# Transcription + Diarization (required for mic streaming and audio file upload)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Database — REQUIRED IN PRODUCTION. Without these the app silently falls back
# to per-instance in-memory storage, which breaks across serverless instances.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Observability (optional — LangSmith tracing)
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=veritas

# Rate limiting — REQUIRED FOR PUBLIC DEPLOYS. Without these the app falls
# back to a per-process in-memory limiter that does not survive Vercel
# cold starts and does not protect across regions. Get a free pair from
# https://console.upstash.com (Redis → REST).
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
